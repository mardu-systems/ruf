 			break;
@@ -183,16 +201,29 @@
 		goto out;
 	}
 
+	*ppaconn = c;
 	pa_threaded_mainloop_lock(c->mainloop);
 	if (pa_threaded_mainloop_start(c->mainloop) < 0)
 		err = EINVAL;
 
+	uint64_t deadline = tmr_jiffies() + 3000;
+	while (!err && pa_context_get_state(c->context) != PA_CONTEXT_READY) {
+		if (!PA_CONTEXT_IS_GOOD(pa_context_get_state(c->context))) err = ENODEV;
+		else if (tmr_jiffies() >= deadline) err = ETIMEDOUT;
+		else {
+			pa_threaded_mainloop_unlock(c->mainloop);
+			sys_msleep(5);
+			pa_threaded_mainloop_lock(c->mainloop);
+		}
+	}
 	pa_threaded_mainloop_unlock(c->mainloop);
 	info ("pulse: initialized (%m)\n", err);
 
   out:
-	if (err)
+	if (err) {
+		*ppaconn = NULL;
 		mem_deref(c);
+	}
 	else
 		*ppaconn = c;
 
@@ -264,15 +295,18 @@
 	int err;
 
 	memset(&pa, 0, sizeof(pa));
-	err = pa_start();
-	if (err)
-		return err;
-
