@@ -40,6 +41,22 @@
 
 
 static struct pa pa;
+static atomic_int terminal_error;
+
+int pulse_error(void) { return atomic_load(&terminal_error); }
+void pulse_failed(void) { atomic_store(&terminal_error, ENODEV); }
+
+/* The SIP loop calls this only after all failed streams have been released. */
+void pulse_recover(void)
+{
+	struct paconn_st *c = pa.paconn;
+	if (!c || !atomic_load(&terminal_error))
+		return;
+	pa_threaded_mainloop_lock(c->mainloop);
+	if (c->context && pa_context_get_state(c->context) == PA_CONTEXT_READY)
+		atomic_store(&terminal_error, 0);
+	pa_threaded_mainloop_unlock(c->mainloop);
+}
 
 
 static int paconn_start(struct paconn_st **ppaconn);
