diff --git a/modules/wasapi/wasapi.h b/modules/wasapi/wasapi.h
--- a/modules/wasapi/wasapi.h
+++ b/modules/wasapi/wasapi.h
@@ -1,3 +1,54 @@
+#ifndef WASAPI_H
+#define WASAPI_H
+#include <re_atomic.h>
+#include <wchar.h>
+
+/* Startup waits for IAudioClient_Start, not merely successful thread creation. */
+enum { WASAPI_START_MS = 5000, WASAPI_RECOVERY_MS = 5000,
+       WASAPI_RETRY_MS = 100, WASAPI_DEFAULT_CHECK_MS = 250 };
+static inline int wasapi_wait_start(RE_ATOMIC int *status)
+{
+	uint64_t deadline = tmr_jiffies() + WASAPI_START_MS;
+	int result;
+	while ((result = (int)re_atomic_load(status, re_memory_order_acquire)) == EINPROGRESS) {
+		if (tmr_jiffies() >= deadline) {
+			int pending = EINPROGRESS;
+			if (re_atomic_compare_exchange_strong(status, &pending, ETIMEDOUT,
+			    re_memory_order_acq_rel, re_memory_order_acquire)) return ETIMEDOUT;
+			continue; /* The worker may have won at the timeout boundary. */
+		}
+		sys_msleep(1);
+	}
+	return result;
+}
+/* Success and cancellation race through one atomic transition. A cancelled
+ * startup must never enter a media callback that its waiting owner may lock. */
+static inline bool wasapi_started(RE_ATOMIC int *status)
+{
+	int pending = EINPROGRESS;
+	return re_atomic_compare_exchange_strong(status, &pending, 0,
+		re_memory_order_acq_rel, re_memory_order_acquire) || pending == 0;
+}
+static inline bool wasapi_recoverable(HRESULT result)
+{
+	return result == AUDCLNT_E_DEVICE_INVALIDATED ||
+	       result == AUDCLNT_E_RESOURCES_INVALIDATED ||
+	       result == AUDCLNT_E_SERVICE_NOT_RUNNING;
+}
+static inline bool wasapi_default_changed(IMMDeviceEnumerator *enumerator,
+					 int flow, LPCWSTR current)
+{
+	IMMDevice *device = NULL;
+	LPWSTR id = NULL;
+	HRESULT result = IMMDeviceEnumerator_GetDefaultAudioEndpoint(enumerator,
+		flow, eCommunications, &device);
+	if (SUCCEEDED(result)) result = IMMDevice_GetId(device, &id);
+	bool changed = FAILED(result) || !id || !current || wcscmp(id, current);
+	CoTaskMemFree(id);
+	if (device) IMMDevice_Release(device);
+	return changed;
+}
+
 /**
  * @file wasapi/wasapi.h Windows Audio Session API (WASAPI)
  *
@@ -57,3 +108,7 @@
 		      ausrc_read_h *rh, ausrc_error_h *errh, void *arg);
 int wasapi_wc_to_utf8(char **dst, LPCWSTR src);
 int wasapi_wc_from_utf8(LPWSTR *dst, const struct pl *src);
+
+int wasapi_play_error(const struct auplay_st *st);
+
+#endif
